# Copy to .env at the repo root. Never commit .env.

# Neon Postgres direct connection string. Both the Python scraper and the Node API use it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Node API
PORT=3001
# Comma-separated list of allowed browser origins (the Vercel frontend URL in production).
CORS_ORIGIN=http://localhost:3000
# Interpreter the API spawns for POST /ingest/trigger, resolved from the repo root.
# Windows venv: .venv/Scripts/python.exe   Linux venv: .venv/bin/python
# The Docker image puts its venv on PATH, so plain `python` works there.
PYTHON_BIN=.venv/Scripts/python.exe

# Next.js frontend. Inlined at build time, so set it on Vercel BEFORE deploying.
NEXT_PUBLIC_API_URL=http://localhost:3001
